  "concepts": [
    {
      "id": "urn:uuid:197dec34-fe26-5705-b53e-713174a17f60",
      "code": "CONCRETO_FCK",
      "logical_type": "decimal",
      "dimension": "pressure",
      "unit_id": "urn:uuid:da77ecae-bab9-5516-985f-07fbd4d16cdc",
      "labels": [
        {
          "lang": "pt-BR",
          "text": "Resistência característica à compressão do concreto (fck)"
        },
        {
          "lang": "en",
          "text": "Characteristic compressive strength of concrete (fck)"
        }
      ],
      "definition": [
        {
          "lang": "pt-BR",
          "text": "Valor característico da resistência à compressão do concreto aos 28 dias, que define a classe de resistência (C20 = 20 MPa)."
        }
      ],
      "qualifiers": [
        {
          "name": "chave_estudo",
          "value": "fck"
        },
        {
          "name": "nome_padronizado",
          "value": "EB_Orçamento.Concreto_fck_MPa"
        }
      ],
      "source_assertion_ids": [
        "abnt:nbr6118-2023.s8.2.1",
        "abnt:nbr8953-2015.t1"
      ],
      "lifecycle": "draft",
      "notes": "fcd (resistência de cálculo) e fct (tração) NÃO são sinônimos (M1 §2.2)."
    },
    {
      "id": "urn:uuid:f2f6a36d-b866-5c31-b009-320b303c3c54",
      "code": "COBRIMENTO_NOMINAL",
      "logical_type": "decimal",
      "dimension": "length",
      "unit_id": "urn:uuid:c04d9ef5-fda7-5392-8e1d-6b4e86bcfbf7",
      "labels": [
        {
          "lang": "pt-BR",
          "text": "Cobrimento nominal da armadura (cnom)"
        },
        {
          "lang": "en",
          "text": "Nominal concrete cover (cnom)"
        }
      ],
      "definition": [
        {
          "lang": "pt-BR",
          "text": "Espessura de concreto entre a face externa da armadura mais próxima e a superfície do elemento, cobrimento mínimo acrescido da tolerância Δc."
        }
      ],
      "qualifiers": [
        {
          "name": "chave_estudo",
          "value": "cobrimento"
        },
        {
          "name": "nome_padronizado",
          "value": "EB_Orçamento.Cobrimento_Nominal_mm"
        }
      ],
      "source_assertion_ids": [
        "abnt:nbr6118-2023.t7.2"
      ],
      "lifecycle": "draft"
    },
    {
      "id": "urn:uuid:6933a03b-0775-57f5-a864-f22b7ac31f66",
      "code": "CLASSE_AGRESSIVIDADE_AMBIENTAL",
      "logical_type": "code",
      "value_set_id": "urn:uuid:1c536294-c335-5a70-90fb-e17748677962",
      "labels": [
        {
          "lang": "pt-BR",
          "text": "Classe de agressividade ambiental (CAA)"
        },
        {
          "lang": "en",
          "text": "Environmental aggressiveness class (CAA)"
        }
      ],
      "definition": [
        {
          "lang": "pt-BR",
          "text": "Classificação do ambiente de exposição da estrutura, de I (fraca) a IV (muito forte), que fixa cobrimento e classe mínima de concreto."
        }
      ],
      "qualifiers": [
        {
          "name": "chave_estudo",
          "value": "caa"
        },
        {
          "name": "nome_padronizado",
