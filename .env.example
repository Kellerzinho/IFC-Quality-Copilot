# ATENÇÃO: estes valores são os mesmos defaults de src/config.py. Divergir deles
# muda o instrumento de medição em silêncio — copiar este arquivo para .env não
# pode alterar nenhum resultado do benchmark.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TEMPERATURE=0.1
# Janela de contexto: 'fixed' usa OLLAMA_NUM_CTX_FIXED em toda chamada; 'fit'
# dimensiona ao prompt usando OLLAMA_NUM_CTX como teto. O padrão é 'fixed'
# porque a alternância de janela força o Ollama a realocar o KV cache — medido
# em ~7% do tempo de fila na rodada de 2026-08-10.
OLLAMA_NUM_CTX_POLICY=fixed
OLLAMA_NUM_CTX_FIXED=4096
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=768
OLLAMA_SEED=42
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_THINK=false
OLLAMA_GENERATE_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_BACKOFF_SECONDS=1.0

# Grounding
GROUNDING_MODE=none
POST_VALIDATION_ENABLED=true

# bSDD (vocabulário semântico)
BSDD_BASE_URL=https://api.bsdd.buildingsmart.org
BSDD_API_URL=https://api.bsdd.buildingsmart.org
BSDD_TIMEOUT_SECONDS=10
BSDD_CACHE_ENABLED=true
BSDD_CACHE_PATH=data/cache/bsdd_cache.json

# Caminhos
IDS_XSD_PATH=data/ids_schema/ids.xsd
IFC_UPLOAD_DIR=./uploads
LOG_LEVEL=DEBUG
