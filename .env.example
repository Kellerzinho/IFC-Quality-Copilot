OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
# Parâmetros de qualidade — ajuste conforme seu hardware
# Para modelos maiores (qwen2.5:32b, llama3.3:70b), estes valores já são adequados
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_THINK=false
OLLAMA_GENERATE_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_BACKOFF_SECONDS=1.0

# Heurísticas e grounding
ENABLE_HEURISTICS=false
GROUNDING_MODE=none
POST_VALIDATION_ENABLED=true

# bSDD (vocabulário semântico)
BSDD_BASE_URL=https://api.bsdd.buildingsmart.org
BSDD_API_URL=https://api.bsdd.buildingsmart.org
BSDD_TIMEOUT_SECONDS=10
BSDD_CACHE_ENABLED=true
BSDD_CACHE_PATH=data/cache/bsdd_cache.json

# Caminhos
IDS_XSD_PATH=data/ids_schema/ids.xsd
IFC_UPLOAD_DIR=./uploads
LOG_LEVEL=DEBUG
