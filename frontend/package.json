{
  "name": "ifc-quality-copilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:viewer": "node scripts/copy-viewer-assets.mjs",
    "predev": "node scripts/copy-viewer-assets.mjs",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "prebuild": "node scripts/copy-viewer-assets.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "check:dist": "node scripts/check-dist-local.mjs",
    "verify:local": "npm run build && npm run check:dist",
    "test": "vitest run",
    "gen:api": "uv run --directory .. python -m src.review_api.export_openapi frontend/openapi.json && openapi-typescript openapi.json -o src/shared/contracts.ts",
    "check:api": "node scripts/check-api-types.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.184.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@thatopen/components": "3.4.9",
    "@thatopen/fragments": "3.4.8",
    "camera-controls": "3.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.56.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.5",
    "tailwind-merge": "3.7.0",
    "three": "0.184.0",
    "web-ifc": "0.0.77"
  }
}
