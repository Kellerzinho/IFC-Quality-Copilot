  "components": {
    "schemas": {
      "AbstainedSuggestion": {
        "additionalProperties": false,
        "description": "Abstenção PROVISÓRIA: motivo sem valor algum (extra=forbid recusa value).",
        "properties": {
          "outcome": {
            "const": "abstained",
            "title": "Outcome",
            "type": "string"
          },
          "schema_status": {
            "const": "provisorio_aguardando_M2_M3",
            "default": "provisorio_aguardando_M2_M3",
            "title": "Schema Status",
            "type": "string"
          },
          "field": {
            "$ref": "#/components/schemas/FieldRef"
          },
          "reason": {
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "field",
          "reason"
        ],
        "title": "AbstainedSuggestion",
        "type": "object"
      },
      "ApiError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ApiError",
        "description": "Erro legível, sem stack trace nem caminho privado."
      },
      "ConfirmBindingRequest": {
        "properties": {
          "ifc_revision_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Ifc Revision Id"
          },
          "ids_revision_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Ids Revision Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ifc_revision_id",
          "ids_revision_id"
        ],
        "title": "ConfirmBindingRequest",
        "description": "Confirmação explícita das revisões IFC e IDS de uma linha."
      },
      "CreateProjectRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateProjectRequest",
        "description": "Pedido de criação de projeto."
      },
      "ElementList": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "m4-plataforma-base/1",
            "title": "Schema Version",
            "default": "m4-plataforma-base/1"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "ifc_revision_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Ifc Revision Id"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ElementRecord"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_id",
          "ifc_revision_id",
          "total",
          "items"
        ],
        "title": "ElementList",
        "description": "Elementos de uma revisão IFC, em ordem estável de express_id."
      },
      "ElementRecord": {
        "properties": {
          "ref": {
            "$ref": "#/components/schemas/ElementRef"
          },
          "ifc_class": {
            "type": "string",
            "title": "Ifc Class"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "global_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Global Id",
            "description": "Atributo IFC; não é identidade."
          },
          "global_id_state": {
            "type": "string",
            "enum": [
              "unique",
              "duplicated_in_file",
              "missing"
            ],
            "title": "Global Id State"
          },
          "has_geometry": {
            "type": "boolean",
            "title": "Has Geometry"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ref",
          "ifc_class",
          "global_id_state",
          "has_geometry"
        ],
        "title": "ElementRecord",
        "description": "Resumo de navegação de um elemento (não é evidência de requisito)."
      },
      "ElementRef": {
        "additionalProperties": false,
        "description": "Identidade de um elemento: modelo lógico + revisão IFC + express_id.\n\nO GlobalId NÃO faz parte da chave: dois arquivos (ou duas entidades do\nmesmo arquivo) podem repetir GlobalId e continuam sendo elementos distintos.\nO express_id só localiza a entidade naquela revisão; não indica\ncontinuidade entre revisões.",
        "properties": {
          "model_id": {
            "minLength": 1,
            "title": "Model Id",
            "type": "string"
          },
          "ifc_revision_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Ifc Revision Id",
            "type": "string"
          },
          "express_id": {
            "exclusiveMinimum": 0,
            "title": "Express Id",
            "type": "integer"
          }
        },
        "required": [
          "model_id",
          "ifc_revision_id",
          "express_id"
        ],
        "title": "ElementRef",
        "type": "object"
      },
      "FieldAlternative": {
        "additionalProperties": false,
        "description": "Alternativa proposta: valor, método, evidências e limitações.",
        "properties": {
          "alternative_id": {
            "title": "Alternative Id",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/ProposedValue"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          },
          "justification": {
            "title": "Justification",
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          }
        },
        "required": [
          "alternative_id",
          "value",
          "method",
          "evidence",
          "justification"
        ],
        "title": "FieldAlternative",
        "type": "object"
      },
      "FieldRef": {
        "additionalProperties": false,
        "description": "Campo-alvo de enriquecimento num elemento identificado.",
        "properties": {
          "element": {
            "$ref": "#/components/schemas/ElementRef"
          },
