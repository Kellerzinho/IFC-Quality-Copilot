              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/models/{model_id}/elements/{express_id}": {
      "get": {
        "tags": [
          "analise"
        ],
        "summary": "Get Element",
        "description": "Resolve um express_id (ex.: vindo do viewer) para o ElementRecord da linha.\n\nUm id que não pertence à lista de elementos responde 404; nunca devolve\noutro elemento parecido.",
        "operationId": "getElement",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          },
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Model Id"
            }
          },
          {
            "name": "express_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Express Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElementRecord"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
