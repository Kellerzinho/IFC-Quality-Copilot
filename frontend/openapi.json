    "/api/v1/health": {
      "get": {
        "tags": [
          "sistema"
        ],
        "summary": "Health",
        "description": "Indica que a API local está respondendo.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
