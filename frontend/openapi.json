    "/api/v1/projects/{project_id}/models/{model_id}/gaps": {
      "get": {
        "tags": [
          "analise"
        ],
        "summary": "Get Gaps",
        "description": "Lista lacunas PROVISÓRIAS (adaptador legado) de uma linha confirmada.",
        "operationId": "listGaps",
        "parameters": [
          {
            "name": "project_id",
